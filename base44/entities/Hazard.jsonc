{
  "name": "Hazard",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "hazard_type": {
      "type": "string",
      "enum": [
        "flood",
        "stagnation",
        "damaged_road",
        "closure",
        "cyclone",
        "tsunami",
        "earthquake",
        "landslide",
        "fire",
        "industrial",
        "debris",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "caution",
        "elevated",
        "severe"
      ],
      "default": "caution"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "observed",
        "official",
        "forecast",
        "historical",
        "simulated"
      ],
      "default": "simulated"
    },
    "district": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "radius_km": {
      "type": "number"
    },
    "extent_notes": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "last_update": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "active",
        "under_review",
        "expired",
        "withdrawn"
      ],
      "default": "under_review"
    },
    "source": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "official",
        "verified",
        "unverified",
        "unverified_demonstration"
      ],
      "default": "unverified"
    },
    "confidence": {
      "type": "number"
    },
    "affected_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_roads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nearby_facilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "precautions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "official_warning_url": {
      "type": "string"
    },
    "water_depth_m": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "is_demonstration": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "hazard_type",
    "lat",
    "lng"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}